{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synapsecommand:hla:local:1:session-summary",
  "title": "synapse-hla live session summary",
  "description": "What host.run_session returns after a live session (round R5; R34, SPEC:168, CR-L03). status is the footer's status, or INCOMPLETE when no footer could be written (an I/O failure of the capture, SPEC:293); reason_code is the footer's. terminal_codes lists every terminal failure of the session in the order it occurred, the footer's reason first, for the exit priority of OPS-02. capture_complete is null: completion of a live session is decided by the footer, not by the records (SPEC:158). last_seq is the seq of the last record written (0 when only the header is), frames the frames written, last_generation the highest generation started, workers the worker processes started. records, suppressions, errors, warnings and files are as in the replay summary, for the live outputs.",
  "type": "object",
  "properties": {
    "session_summary_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "COMPLETE",
        "FAILED",
        "INCOMPLETE"
      ]
    },
    "reason_code": {
      "anyOf": [
        {
          "enum": [
            "E_CONFIG",
            "E_DEPENDENCY_PIN",
            "E_OUTPUT_EXISTS",
            "E_FOM_PROFILE",
            "E_FEDERATE_NAME",
            "E_RTI_CONNECT",
            "E_RTI_TIMEOUT",
            "E_ATTRIBUTE_LENGTH",
            "E_NONFINITE",
            "E_BOOLEAN",
            "E_SPATIAL_VARIANT",
            "E_UNSUBSCRIBED_ATTRIBUTE",
            "E_NULL_ID",
            "E_ECEF_RANGE",
            "E_GEODESY",
            "E_TIME_REGRESSION",
            "E_IDENTITY_CHANGED",
            "E_IDENTITY_COLLISION",
            "E_RETRACTION_UNSUPPORTED",
            "E_UNKNOWN_OBJECT",
            "E_LIMIT",
            "E_QUEUE_OVERFLOW",
            "E_IO",
            "E_CAPTURE_SCHEMA",
            "E_CAPTURE_HASH",
            "E_CAPTURE_SEQUENCE",
            "E_CAPTURE_INCOMPLETE"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal_codes": {
      "type": "array",
      "items": {
        "enum": [
          "E_CONFIG",
          "E_DEPENDENCY_PIN",
          "E_OUTPUT_EXISTS",
          "E_FOM_PROFILE",
          "E_FEDERATE_NAME",
          "E_RTI_CONNECT",
          "E_RTI_TIMEOUT",
          "E_ATTRIBUTE_LENGTH",
          "E_NONFINITE",
          "E_BOOLEAN",
          "E_SPATIAL_VARIANT",
          "E_UNSUBSCRIBED_ATTRIBUTE",
          "E_NULL_ID",
          "E_ECEF_RANGE",
          "E_GEODESY",
          "E_TIME_REGRESSION",
          "E_IDENTITY_CHANGED",
          "E_IDENTITY_COLLISION",
          "E_RETRACTION_UNSUPPORTED",
          "E_UNKNOWN_OBJECT",
          "E_LIMIT",
          "E_QUEUE_OVERFLOW",
          "E_IO",
          "E_CAPTURE_SCHEMA",
          "E_CAPTURE_HASH",
          "E_CAPTURE_SEQUENCE",
          "E_CAPTURE_INCOMPLETE"
        ]
      },
      "uniqueItems": true
    },
    "capture_complete": {
      "type": "null"
    },
    "last_seq": {
      "$ref": "#/$defs/count"
    },
    "frames": {
      "$ref": "#/$defs/count"
    },
    "last_generation": {
      "$ref": "#/$defs/count"
    },
    "workers": {
      "$ref": "#/$defs/count"
    },
    "records": {
      "type": "object",
      "properties": {
        "diagnostic": {
          "$ref": "#/$defs/count"
        },
        "snapshot": {
          "$ref": "#/$defs/count"
        },
        "upsert": {
          "$ref": "#/$defs/count"
        },
        "removed": {
          "$ref": "#/$defs/count"
        },
        "invalidated": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "diagnostic",
        "snapshot",
        "upsert",
        "removed",
        "invalidated"
      ],
      "additionalProperties": false
    },
    "suppressions": {
      "type": "object",
      "properties": {
        "MISSING_ENTITY_IDENTIFIER": {
          "$ref": "#/$defs/count"
        },
        "MISSING_ENTITY_TYPE": {
          "$ref": "#/$defs/count"
        },
        "MISSING_SPATIAL": {
          "$ref": "#/$defs/count"
        },
        "INVALID_ENTITY_IDENTIFIER": {
          "$ref": "#/$defs/count"
        },
        "INVALID_ENTITY_TYPE": {
          "$ref": "#/$defs/count"
        },
        "INVALID_SPATIAL": {
          "$ref": "#/$defs/count"
        },
        "INVALID_FORCE_IDENTIFIER": {
          "$ref": "#/$defs/count"
        },
        "NULL_ID": {
          "$ref": "#/$defs/count"
        },
        "QUARANTINED": {
          "$ref": "#/$defs/count"
        },
        "TIME_UNRESOLVED": {
          "$ref": "#/$defs/count"
        },
        "GEOGRAPHY_UNPROJECTABLE": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "MISSING_ENTITY_IDENTIFIER",
        "MISSING_ENTITY_TYPE",
        "MISSING_SPATIAL",
        "INVALID_ENTITY_IDENTIFIER",
        "INVALID_ENTITY_TYPE",
        "INVALID_SPATIAL",
        "INVALID_FORCE_IDENTIFIER",
        "NULL_ID",
        "QUARANTINED",
        "TIME_UNRESOLVED",
        "GEOGRAPHY_UNPROJECTABLE"
      ],
      "additionalProperties": false
    },
    "errors": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "E_CONFIG",
          "E_DEPENDENCY_PIN",
          "E_OUTPUT_EXISTS",
          "E_FOM_PROFILE",
          "E_FEDERATE_NAME",
          "E_RTI_CONNECT",
          "E_RTI_TIMEOUT",
          "E_ATTRIBUTE_LENGTH",
          "E_NONFINITE",
          "E_BOOLEAN",
          "E_SPATIAL_VARIANT",
          "E_UNSUBSCRIBED_ATTRIBUTE",
          "E_NULL_ID",
          "E_ECEF_RANGE",
          "E_GEODESY",
          "E_TIME_REGRESSION",
          "E_IDENTITY_CHANGED",
          "E_IDENTITY_COLLISION",
          "E_RETRACTION_UNSUPPORTED",
          "E_UNKNOWN_OBJECT",
          "E_LIMIT",
          "E_QUEUE_OVERFLOW",
          "E_IO",
          "E_CAPTURE_SCHEMA",
          "E_CAPTURE_HASH",
          "E_CAPTURE_SEQUENCE",
          "E_CAPTURE_INCOMPLETE"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/positive"
      }
    },
    "warnings": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "W_FOM_UNVERIFIED",
          "W_TIME_UNRESOLVED",
          "W_FORCE_UNMAPPED",
          "W_DUPLICATE_DISCOVERY",
          "W_DUPLICATE_REMOVE"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/positive"
      }
    },
    "files": {
      "type": "object",
      "properties": {
        "capture.jsonl": {
          "$ref": "#/$defs/file"
        },
        "observations.jsonl": {
          "$ref": "#/$defs/file"
        },
        "diagnostics.jsonl": {
          "$ref": "#/$defs/file"
        }
      },
      "required": [
        "capture.jsonl",
        "observations.jsonl",
        "diagnostics.jsonl"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "session_summary_version",
    "status",
    "reason_code",
    "terminal_codes",
    "capture_complete",
    "last_seq",
    "frames",
    "last_generation",
    "workers",
    "records",
    "suppressions",
    "errors",
    "warnings",
    "files"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETE"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "type": "null"
          },
          "terminal_codes": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "enum": [
              "E_CONFIG",
              "E_DEPENDENCY_PIN",
              "E_OUTPUT_EXISTS",
              "E_FOM_PROFILE",
              "E_FEDERATE_NAME",
              "E_RTI_CONNECT",
              "E_RTI_TIMEOUT",
              "E_ATTRIBUTE_LENGTH",
              "E_NONFINITE",
              "E_BOOLEAN",
              "E_SPATIAL_VARIANT",
              "E_UNSUBSCRIBED_ATTRIBUTE",
              "E_NULL_ID",
              "E_ECEF_RANGE",
              "E_GEODESY",
              "E_TIME_REGRESSION",
              "E_IDENTITY_CHANGED",
              "E_IDENTITY_COLLISION",
              "E_RETRACTION_UNSUPPORTED",
              "E_UNKNOWN_OBJECT",
              "E_LIMIT",
              "E_QUEUE_OVERFLOW",
              "E_IO",
              "E_CAPTURE_SCHEMA",
              "E_CAPTURE_HASH",
              "E_CAPTURE_SEQUENCE",
              "E_CAPTURE_INCOMPLETE"
            ]
          },
          "terminal_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "INCOMPLETE"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "type": "null"
          },
          "terminal_codes": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "file": {
      "type": "object",
      "properties": {
        "bytes": {
          "$ref": "#/$defs/count"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
