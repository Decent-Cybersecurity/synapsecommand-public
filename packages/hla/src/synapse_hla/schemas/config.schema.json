{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synapsecommand:hla:1:config",
  "type": "object",
  "properties": {
    "profile": {
      "const": "SC-HLA-RPR2-OBS-1"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$(?![\\s\\S])"
    },
    "source_system": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "existing",
        "demo"
      ]
    },
    "endpoint": {
      "type": "string",
      "pattern": "^rti://[0-9.]+:[0-9]+$(?![\\s\\S])",
      "maxLength": 64
    },
    "allow_remote": {
      "type": "boolean"
    },
    "federation_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$(?![\\s\\S])"
    },
    "federate_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$(?![\\s\\S])"
    },
    "profile_declaration": {
      "enum": [
        "external-fom-unverified",
        "bundled-fom-created"
      ]
    },
    "time_policy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "none"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "external_elapsed"
            },
            "epoch": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$(?![\\s\\S])",
              "format": "date-time"
            },
            "basis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "mode",
            "epoch",
            "basis"
          ],
          "additionalProperties": false
        }
      ]
    },
    "force_map": {
      "type": "object",
      "patternProperties": {
        "^(0|[1-9][0-9]{0,2})$(?![\\s\\S])": {
          "enum": [
            "FRIENDLY",
            "HOSTILE",
            "NEUTRAL",
            "UNKNOWN"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "profile",
    "session_id",
    "source_system",
    "synthetic",
    "mode",
    "endpoint",
    "allow_remote",
    "federation_name",
    "federate_name",
    "profile_declaration",
    "time_policy",
    "force_map"
  ],
  "additionalProperties": false
}
