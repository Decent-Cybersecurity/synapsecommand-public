{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synapsecommand:hla:1:header",
  "type": "object",
  "properties": {
    "type": {
      "const": "header"
    },
    "capture_version": {
      "const": 1
    },
    "profile": {
      "const": "SC-HLA-RPR2-OBS-1"
    },
    "adapter_version": {
      "const": "1.0.0"
    },
    "config": {
      "$ref": "config.schema.json"
    },
    "pins": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
      }
    },
    "record_created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$(?![\\s\\S])",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "capture_version",
    "profile",
    "adapter_version",
    "config",
    "pins",
    "record_created_at"
  ],
  "additionalProperties": false
}
