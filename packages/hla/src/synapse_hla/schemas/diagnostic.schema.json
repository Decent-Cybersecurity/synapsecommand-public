{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synapsecommand:hla:1:diagnostic",
  "type": "object",
  "properties": {
    "severity": {
      "enum": [
        "ERROR",
        "WARNING"
      ]
    },
    "code": {
      "type": "string",
      "maxLength": 64
    },
    "message": {
      "type": "string",
      "maxLength": 1024
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "object_token": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^o[1-9][0-9]*$(?![\\s\\S])",
          "maxLength": 16
        },
        {
          "type": "null"
        }
      ]
    },
    "attribute": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "severity",
    "code",
    "message",
    "seq",
    "generation",
    "object_token",
    "attribute"
  ],
  "additionalProperties": false
}
