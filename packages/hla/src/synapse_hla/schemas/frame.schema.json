{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synapsecommand:hla:1:frame",
  "type": "object",
  "properties": {
    "type": {
      "const": "frame"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "elapsed_ns": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$(?![\\s\\S])",
      "maxLength": 24
    },
    "event": {
      "$ref": "event.schema.json"
    },
    "prev_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    }
  },
  "required": [
    "type",
    "seq",
    "generation",
    "elapsed_ns",
    "event",
    "prev_sha256",
    "sha256"
  ],
  "additionalProperties": false
}
