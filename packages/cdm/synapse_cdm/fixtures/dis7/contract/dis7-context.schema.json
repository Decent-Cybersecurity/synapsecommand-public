{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synapsecommand:dis7:spec:1.0:dis7-context",
  "type": "object",
  "properties": {
    "session": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$(?![\\s\\S])"
    },
    "synthetic": {
      "type": "boolean"
    },
    "time_context": {
      "type": "object",
      "properties": {
        "instant": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
          "format": "date-time"
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        }
      },
      "required": [
        "instant",
        "basis"
      ],
      "additionalProperties": false
    },
    "source_hash": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "session",
    "synthetic",
    "time_context"
  ],
  "additionalProperties": false
}
