{
  "rule": "SEM-003",
  "title": "Every position is [lon, lat] or [lon, lat, alt] inside WGS84 bounds; every LineString part has at least two positions",
  "cases": [
    {
      "name": "in bounds, lon first",
      "document": {
        "object_kind": "plan_object", "schema_version": "2.1.0",
        "source": {"system": "TEST", "adapter": "test", "adapter_version": "1.0.0", "synthetic": true},
        "source_ids": [{"system": "TEST", "external_id": "P-3"}],
        "object_id": "0d5c2d0e-6b9a-4c1f-9a3e-2f7b8c4d1e03",
        "object_type": "ROUTE",
        "geometry": {"type": "LineString", "coordinates": [[21.0, 57.0], [22.0, 58.0]]}
      },
      "expected": {"structural": "PASS", "semantic": "PASS"}
    },
    {
      "name": "latitude 91 (the [lat, lon] swap)",
      "document": {
        "object_kind": "plan_object", "schema_version": "2.1.0",
        "source": {"system": "TEST", "adapter": "test", "adapter_version": "1.0.0", "synthetic": true},
        "source_ids": [{"system": "TEST", "external_id": "P-3"}],
        "object_id": "0d5c2d0e-6b9a-4c1f-9a3e-2f7b8c4d1e03",
        "object_type": "ROUTE",
        "geometry": {"type": "Point", "coordinates": [57.0, 91.0]}
      },
      "expected": {"structural": "PASS", "semantic": "FAIL", "finding_contains": "SEM-003"}
    },
    {
      "name": "a single number is not a position",
      "document": {
        "object_kind": "plan_object", "schema_version": "2.1.0",
        "source": {"system": "TEST", "adapter": "test", "adapter_version": "1.0.0", "synthetic": true},
        "source_ids": [{"system": "TEST", "external_id": "P-3"}],
        "object_id": "0d5c2d0e-6b9a-4c1f-9a3e-2f7b8c4d1e03",
        "object_type": "ROUTE",
        "geometry": {"type": "Point", "coordinates": [21.0]}
      },
      "expected": {"structural": "PASS", "semantic": "FAIL", "finding_contains": "SEM-003"}
    },
    {
      "name": "a MultiLineString part with one position",
      "document": {
        "object_kind": "plan_object", "schema_version": "2.1.0",
        "source": {"system": "TEST", "adapter": "test", "adapter_version": "1.0.0", "synthetic": true},
        "source_ids": [{"system": "TEST", "external_id": "P-3"}],
        "object_id": "0d5c2d0e-6b9a-4c1f-9a3e-2f7b8c4d1e03",
        "object_type": "ROUTE",
        "geometry": {"type": "MultiLineString", "coordinates": [[[21.0, 57.0]]]}
      },
      "expected": {"structural": "PASS", "semantic": "FAIL", "finding_contains": "SEM-003"}
    }
  ]
}
