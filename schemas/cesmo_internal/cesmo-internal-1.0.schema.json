{
  "type": "object",
  "properties": {
    "contract": {
      "const": "sc.cesmo.internal/1.0"
    },
    "mode": {
      "enum": [
        "synthetic",
        "live"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "network_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "originator_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "identity_epoch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        }
      },
      "required": [
        "network_id",
        "originator_id",
        "identity_epoch"
      ],
      "additionalProperties": false
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:19[7-9][0-9]|[2-9][0-9]{3})-\\d{2}-\\d{2}T\\d{2}:\\d{2}:[0-5]\\d(?:\\.\\d{1,6})?Z$"
    },
    "records": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "complete": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "snapshot_id",
        "complete",
        "revision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "mode",
    "source",
    "message_id",
    "observed_at",
    "records"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sc:cesmo:internal:1.0",
  "title": "SC CESMO internal exchange only - not an AEDP-13 wire schema",
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "kind": {
          "enum": [
            "observation",
            "eob_upsert",
            "eob_delete",
            "status"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:19[7-9][0-9]|[2-9][0-9]{3})-\\d{2}-\\d{2}T\\d{2}:\\d{2}:[0-5]\\d(?:\\.\\d{1,6})?Z$"
        },
        "object_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "signal": {
          "$ref": "#/$defs/signal"
        },
        "uncertainty": {
          "$ref": "#/$defs/ellipse"
        },
        "affiliation": {
          "enum": [
            "FRIENDLY",
            "HOSTILE",
            "NEUTRAL",
            "UNKNOWN"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "record_id",
        "kind",
        "revision",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "properties": {
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "hae_m": {
          "type": "number"
        },
        "method": {
          "enum": [
            "estimated",
            "gnss",
            "inertial",
            "manual"
          ]
        }
      },
      "required": [
        "latitude_deg",
        "longitude_deg",
        "method"
      ],
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "properties": {
        "frequency_hz": {
          "type": "number",
          "minimum": 0
        },
        "bandwidth_hz": {
          "type": "number",
          "minimum": 0
        },
        "pulse_width_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pri_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "power_dbm": {
          "type": "number"
        },
        "bearing_deg_true": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "sensor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    },
    "ellipse": {
      "type": "object",
      "properties": {
        "semi_major_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "semi_minor_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "orientation_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 180
        },
        "probability": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "frame": {
          "const": "ENU_TRUE_NORTH"
        }
      },
      "required": [
        "semi_major_m",
        "semi_minor_m",
        "orientation_deg",
        "probability",
        "frame"
      ],
      "additionalProperties": false
    }
  }
}
