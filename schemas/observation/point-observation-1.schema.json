{
  "$defs": {
    "Absence": {
      "additionalProperties": false,
      "description": "A value the source does not state, and how that is known.\n\n`sentinel` \u2014 the source wrote a marker meaning \"missing\" (`MM`, `-3`); `sentinel` is the\nmarker verbatim and `mechanism` names the table or rule that says what it means.\n`unit_unknown` \u2014 the source wrote a number whose unit cannot be read; the number is NOT\ncarried here (a value with no unit is not a value), and the adapter parks it in its residual.",
      "properties": {
        "cause": {
          "enum": [
            "sentinel",
            "unit_unknown"
          ],
          "title": "Cause",
          "type": "string"
        },
        "mechanism": {
          "minLength": 1,
          "title": "Mechanism",
          "type": "string"
        },
        "sentinel": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentinel"
        }
      },
      "required": [
        "cause",
        "mechanism"
      ],
      "title": "Absence",
      "type": "object"
    },
    "ArrayLocator": {
      "additionalProperties": false,
      "properties": {
        "frame_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the frame handed to the adapter, when it is not the whole file `source.source_hash` digests. Computed by the host, never by the adapter.",
          "title": "Frame Sha256"
        },
        "granule_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The granule a band file belongs to, shared by its files.",
          "title": "Granule Id"
        },
        "group": {
          "description": "The group path from the root, `/` for the root itself.",
          "pattern": "^/",
          "title": "Group",
          "type": "string"
        },
        "index": {
          "description": "An element's index; empty = the whole variable.",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Index",
          "type": "array"
        },
        "kind": {
          "enum": [
            "netcdf",
            "hdf5"
          ],
          "title": "Kind",
          "type": "string"
        },
        "variable": {
          "minLength": 1,
          "title": "Variable",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "group",
        "variable"
      ],
      "title": "ArrayLocator",
      "type": "object"
    },
    "CodedValue": {
      "additionalProperties": false,
      "description": "A code from a named table, verbatim; `meaning` only as the table's own words.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "meaning": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meaning"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "code",
        "namespace"
      ],
      "title": "CodedValue",
      "type": "object"
    },
