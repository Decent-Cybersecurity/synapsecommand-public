  "$id": "urn:synapsecommand:observation:point-observation:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`point-observation/1`: the readings one record states for one station.",
  "properties": {
    "contract": {
      "const": "point-observation/1",
      "title": "Contract",
      "type": "string"
    },
    "locator": {
      "discriminator": {
        "mapping": {
          "grib": "#/$defs/GribLocator",
          "hdf5": "#/$defs/ArrayLocator",
          "netcdf": "#/$defs/ArrayLocator",
          "parquet": "#/$defs/ParquetLocator",
          "radar": "#/$defs/RadarLocator",
          "raster": "#/$defs/RasterLocator",
          "table": "#/$defs/TableLocator"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GribLocator"
        },
        {
          "$ref": "#/$defs/RadarLocator"
        },
        {
          "$ref": "#/$defs/TableLocator"
        },
        {
          "$ref": "#/$defs/RasterLocator"
        },
        {
          "$ref": "#/$defs/ParquetLocator"
        },
        {
          "$ref": "#/$defs/ArrayLocator"
        }
      ],
      "title": "Locator"
    },
    "product_class": {
      "enum": [
        "observation",
        "forecast",
        "analysis",
        "reanalysis",
        "modelled_estimate",
        "reference"
      ],
      "title": "Product Class",
      "type": "string"
    },
    "product_version": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProductVersion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quality_flags": {
      "items": {
        "$ref": "#/$defs/QualityFlag"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "quality_flags_basis": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why there are no quality flags: the format publishes none, or none is set. Required exactly when quality_flags is empty.",
      "title": "Quality Flags Basis"
    },
