    "QualityFlag": {
      "additionalProperties": false,
      "description": "One quality flag, verbatim: its name, its value, the table it belongs to, what it covers.\n\nNobody interprets it here \u2014 not into a confidence, not into a pass/fail. `applies_to` names\nthe reading, moment, variable or `record` the flag describes; its value is never an instant.",
      "properties": {
        "applies_to": {
          "minLength": 1,
          "title": "Applies To",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value",
        "namespace",
        "applies_to"
      ],
      "title": "QualityFlag",
      "type": "object"
    },
