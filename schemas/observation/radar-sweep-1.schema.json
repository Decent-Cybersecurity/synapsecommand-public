{
  "$defs": {
    "ArrayLocator": {
      "additionalProperties": false,
      "properties": {
        "frame_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the frame handed to the adapter, when it is not the whole file `source.source_hash` digests. Computed by the host, never by the adapter.",
          "title": "Frame Sha256"
        },
        "granule_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The granule a band file belongs to, shared by its files.",
          "title": "Granule Id"
        },
        "group": {
          "description": "The group path from the root, `/` for the root itself.",
          "pattern": "^/",
          "title": "Group",
          "type": "string"
        },
        "index": {
          "description": "An element's index; empty = the whole variable.",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Index",
          "type": "array"
        },
        "kind": {
          "enum": [
            "netcdf",
            "hdf5"
          ],
          "title": "Kind",
          "type": "string"
        },
        "variable": {
          "minLength": 1,
          "title": "Variable",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "group",
        "variable"
      ],
      "title": "ArrayLocator",
      "type": "object"
    },
    "ArraySummary": {
      "additionalProperties": false,
      "description": "What a consumer may know about an array without opening it.",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "missing_count": {
          "minimum": 0,
          "title": "Missing Count",
          "type": "integer"
        }
      },
      "required": [
        "count",
        "missing_count"
      ],
      "title": "ArraySummary",
      "type": "object"
    },
    "CodedValue": {
      "additionalProperties": false,
      "description": "A code from a named table, verbatim; `meaning` only as the table's own words.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "meaning": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meaning"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "code",
        "namespace"
      ],
      "title": "CodedValue",
      "type": "object"
    },
    "GribLocator": {
      "additionalProperties": false,
      "properties": {
        "byte_offset": {
          "description": "The message's first octet in the file.",
          "minimum": 0,
          "title": "Byte Offset",
          "type": "integer"
        },
        "field": {
          "description": "The field's 0-based ordinal in the message.",
          "minimum": 0,
          "title": "Field",
          "type": "integer"
        },
        "frame_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the frame handed to the adapter, when it is not the whole file `source.source_hash` digests. Computed by the host, never by the adapter.",
          "title": "Frame Sha256"
        },
        "granule_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The granule a band file belongs to, shared by its files.",
          "title": "Granule Id"
        },
        "kind": {
          "const": "grib",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "description": "The message's 0-based ordinal in the file.",
          "minimum": 0,
          "title": "Message",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "message",
        "field",
        "byte_offset"
      ],
      "title": "GribLocator",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "description": "One value with the unit the source stated and the table it was read from.",
      "properties": {
        "unit": {
          "description": "The source's own unit string, verbatim.",
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "unit_namespace": {
          "description": "Where the unit was read: a GRIB table, a CF attribute, a header line.",
          "minLength": 1,
          "title": "Unit Namespace",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit",
        "unit_namespace"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "ParquetLocator": {
      "additionalProperties": false,
      "properties": {
        "frame_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the frame handed to the adapter, when it is not the whole file `source.source_hash` digests. Computed by the host, never by the adapter.",
          "title": "Frame Sha256"
        },
        "granule_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The granule a band file belongs to, shared by its files.",
          "title": "Granule Id"
        },
        "kind": {
          "const": "parquet",
          "title": "Kind",
          "type": "string"
        },
        "row": {
          "description": "The 0-based row inside the row group.",
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "row_group": {
          "minimum": 0,
          "title": "Row Group",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "row_group",
        "row"
      ],
      "title": "ParquetLocator",
      "type": "object"
    },
    "ProductVersion": {
      "additionalProperties": false,
      "description": "Which run, which version, produced when and by whom \u2014 processing facts, never times.",
      "properties": {
        "producer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer"
        },
        "production_time_verbatim": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Production Time Verbatim"
        },
        "run": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run"
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "title": "ProductVersion",
      "type": "object"
    },
    "QualityFlag": {
      "additionalProperties": false,
      "description": "One quality flag, verbatim: its name, its value, the table it belongs to, what it covers.\n\nNobody interprets it here \u2014 not into a confidence, not into a pass/fail. `applies_to` names\nthe reading, moment, variable or `record` the flag describes; its value is never an instant.",
      "properties": {
        "applies_to": {
          "minLength": 1,
          "title": "Applies To",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value",
        "namespace",
        "applies_to"
      ],
      "title": "QualityFlag",
      "type": "object"
    },
    "RadarLocator": {
      "additionalProperties": false,
      "properties": {
        "azimuth_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Azimuth Number"
        },
        "elevation_number": {
          "description": "The elevation NUMBER, 1-based as the volume numbers it; never the angle, which a rescan repeats.",
          "minimum": 1,
          "title": "Elevation Number",
          "type": "integer"
        },
        "frame_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the frame handed to the adapter, when it is not the whole file `source.source_hash` digests. Computed by the host, never by the adapter.",
          "title": "Frame Sha256"
        },
        "granule_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The granule a band file belongs to, shared by its files.",
          "title": "Granule Id"
        },
        "kind": {
          "const": "radar",
          "title": "Kind",
          "type": "string"
        },
        "ldm_record": {
          "minimum": 0,
          "title": "Ldm Record",
          "type": "integer"
        },
        "message": {
          "minimum": 0,
          "title": "Message",
          "type": "integer"
        },
        "moment": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moment"
        }
      },
      "required": [
        "kind",
        "ldm_record",
        "message",
        "elevation_number"
      ],
      "title": "RadarLocator",
      "type": "object"
    },
    "RadarMoment": {
      "additionalProperties": false,
      "description": "One moment of a sweep (reflectivity, velocity \u2026), its gates and its values.",
      "properties": {
        "first_gate_range": {
          "$ref": "#/$defs/Measurement"
        },
        "gate_count": {
          "minimum": 1,
          "title": "Gate Count",
          "type": "integer"
        },
        "gate_interval": {
          "$ref": "#/$defs/Measurement"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnitRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "values": {
          "discriminator": {
            "mapping": {
              "inline": "#/$defs/ValuesInline",
              "reference": "#/$defs/ValuesByReference"
            },
            "propertyName": "mode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ValuesByReference"
            },
            {
              "$ref": "#/$defs/ValuesInline"
            }
          ],
          "title": "Values"
        }
      },
      "required": [
        "name",
        "namespace",
        "gate_count",
        "first_gate_range",
        "gate_interval",
        "values"
      ],
      "title": "RadarMoment",
      "type": "object"
    },
    "RasterLocator": {
