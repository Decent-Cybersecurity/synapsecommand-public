        },
        "ifd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ifd"
        },
        "kind": {
          "const": "raster",
          "title": "Kind",
          "type": "string"
        },
        "tile": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tile"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/RasterWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "RasterLocator",
      "type": "object"
    },
    "RasterWindow": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "column",
        "row",
        "width",
        "height"
      ],
      "title": "RasterWindow",
      "type": "object"
    },
    "TableLocator": {
      "additionalProperties": false,
      "properties": {
        "frame_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the frame handed to the adapter, when it is not the whole file `source.source_hash` digests. Computed by the host, never by the adapter.",
          "title": "Frame Sha256"
        },
        "granule_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The granule a band file belongs to, shared by its files.",
          "title": "Granule Id"
        },
        "header_lines": {
          "minimum": 0,
          "title": "Header Lines",
          "type": "integer"
        },
        "kind": {
          "const": "table",
          "title": "Kind",
          "type": "string"
        },
        "row": {
          "description": "The 0-based data record, after the header lines.",
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "row",
        "header_lines"
      ],
      "title": "TableLocator",
      "type": "object"
    },
    "TimeInputs": {
      "additionalProperties": false,
      "description": "The time facts a model product states beside `observed_at` and `Event.validity`.",
      "properties": {
        "forecast_offset": {
          "anyOf": [
            {
              "$ref": "#/$defs/Measurement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_time": {
          "anyOf": [
            {
              "description": "RFC 3339 UTC, exactly three decimal places, always Z.",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Time"
        },
        "reference_time_significance": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GRIB2 Table 1.2, verbatim, where the source states one."
        },
        "source_time_system": {
          "$ref": "#/$defs/TimeSystem"
        },
        "statistical_process": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodedValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GRIB2 Table 4.10, verbatim, where the source states one."
        }
      },
      "required": [
        "source_time_system"
      ],
      "title": "TimeInputs",
      "type": "object"
    },
    "TimeSystem": {
      "additionalProperties": false,
      "description": "The time system the source's stamps were read in, and who said so.",
      "properties": {
        "basis": {
          "description": "Where it was read, or which declared argument said it.",
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "name": {
          "description": "Verbatim: UTC, GMT, gmt, GPS.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "stated_by": {
          "enum": [
            "source",
            "caller"
          ],
          "title": "Stated By",
          "type": "string"
        }
      },
      "required": [
        "name",
        "stated_by",
        "basis"
      ],
      "title": "TimeSystem",
      "type": "object"
    },
    "UnitRef": {
      "additionalProperties": false,
      "description": "The unit of an array of values, which a `Measurement` would repeat per value.",
      "properties": {
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "unit_namespace": {
          "minLength": 1,
          "title": "Unit Namespace",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "unit_namespace"
      ],
      "title": "UnitRef",
      "type": "object"
    },
    "ValuesByReference": {
      "additionalProperties": false,
      "description": "The values stay in the source; this says where they are and how to open them.",
      "properties": {
        "dtype": {
          "description": "The stored type, verbatim.",
          "minLength": 1,
          "title": "Dtype",
          "type": "string"
        },
        "encoding": {
          "description": "The packing or compression, verbatim.",
          "minLength": 1,
          "title": "Encoding",
          "type": "string"
        },
        "fill": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fill"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "grib": "#/$defs/GribLocator",
              "hdf5": "#/$defs/ArrayLocator",
              "netcdf": "#/$defs/ArrayLocator",
              "parquet": "#/$defs/ParquetLocator",
              "radar": "#/$defs/RadarLocator",
              "raster": "#/$defs/RasterLocator",
              "table": "#/$defs/TableLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/GribLocator"
            },
            {
              "$ref": "#/$defs/RadarLocator"
            },
            {
              "$ref": "#/$defs/TableLocator"
            },
            {
              "$ref": "#/$defs/RasterLocator"
            },
            {
              "$ref": "#/$defs/ParquetLocator"
            },
            {
              "$ref": "#/$defs/ArrayLocator"
            }
          ],
          "title": "Locator"
        },
        "mode": {
          "const": "reference",
          "title": "Mode",
          "type": "string"
        },
        "offset": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset"
        },
        "scale": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "shape": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Shape",
          "type": "array"
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArraySummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode",
        "locator",
        "shape",
        "dtype",
        "encoding"
      ],
      "title": "ValuesByReference",
      "type": "object"
    },
    "ValuesInline": {
      "additionalProperties": false,
      "description": "At most `MAX_INLINE_VALUES` values, in the source's order. `None` is a missing value, and\na contract with one names the mechanism that made it missing.",
      "properties": {
        "missing_mechanism": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Mechanism"
        },
        "mode": {
          "const": "inline",
          "title": "Mode",
          "type": "string"
        },
        "shape": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
